{
  "name": "benchmark-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:all": "npx playwright test --grep-invert @pageload",
    "test:all:csv": "npx tsx run-benchmarks.ts benchmark,chart,memory,build,enterprise,lighthouse 10",
    "test:bench": "npx playwright test --grep @benchmark",
    "test:cellmatrix": "npx playwright test --grep @cellmatrix",
    "test:colscale": "npx playwright test --grep @colscale",
    "test:celltypes": "npx playwright test --grep @celltypes",
    "test:rowinsert": "npx playwright test --grep @rowinsert",
    "test:chart": "npx playwright test --grep @chart-benchmark",
    "test:memory": "npx playwright test --grep @memory",
    "test:rerender": "npx playwright test --grep @rerender",
    "test:initial-render": "npx playwright test --grep @initial-render",
    "test:concurrent": "npx playwright test --grep @concurrent",
    "test:repaint": "npx playwright test --grep @repaint",
    "test:regression": "npx playwright test --grep @regression",
    "test:column-search": "npx playwright test --grep @column-search",
    "test:build": "npx playwright test --grep @build",
    "test:pageload": "npx playwright test --grep @pageload",
    "test:lighthouse": "npx playwright test --grep @lighthouse",
    "test:dom": "npx playwright test --grep @dom",
    "test:latency": "npx playwright test --grep @latency",
    "bench:chart": "npx tsx run-benchmarks.ts chart 10",
    "bench:cellmatrix": "npx tsx run-benchmarks.ts cellmatrix 10",
    "bench:colscale": "npx tsx run-benchmarks.ts colscale 10",
    "bench:celltypes": "npx tsx run-benchmarks.ts celltypes 10",
    "bench:rowinsert": "npx tsx run-benchmarks.ts rowinsert 10",
    "bench:all": "npx tsx run-benchmarks.ts benchmark,chart,memory,build,enterprise,lighthouse 10",
    "bench:10": "npx tsx run-benchmarks.ts all 10",
    "bench:30": "npx tsx run-benchmarks.ts all 30",
    "bench:run": "npx tsx run-benchmarks.ts",
    "report": "npx playwright show-report",
    "install:browsers": "npx playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "exceljs": "^4.4.0",
    "lighthouse": "^12.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
